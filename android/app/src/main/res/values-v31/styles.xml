<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (API 31) system splash screen.

     The user only wants ONE opening screen: the text-based Flutter splash
     (gradient circle + "TapCare" + tagline). The OS splash used to draw a big
     flat pink heart here, which read as a second, plainer splash.

     Android 12 ALWAYS shows an icon in the splash — if
     `windowSplashScreenAnimatedIcon` is omitted it falls back to the app
     launcher icon, and pointing it at a transparent drawable leaves a blank
     pale screen that reads as a white flash.

     So the icon is the real thing: the same gradient-circle heart the Flutter
     splash draws (`ic_tapcare_logo`). System splash and in-app splash are then
     one continuous opening scene — no plain heart, no blank frame between them.

     NOTE: there is no `android:windowSplashScreenIconBackgroundSize`
     platform attribute — only `...IconBackgroundColor`. An earlier revision
     of this file declared the size variant and resource linking failed with
     "style attribute not found". -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/tapcare_blush</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_tapcare_logo</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/tapcare_blush</item>
        <item name="android:windowSplashScreenAnimationDuration">200</item>
    </style>

    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/tapcare_blush</item>
    </style>
</resources>