<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (API 31) system splash screen.

     The user wants exactly ONE opening screen: the text-based Flutter splash
     (gradient circle + "TapCare" + "बिना बोले, ख्याल" + "Care without
     words"). Android 12 refuses to skip its splash entirely, but the icon can
     be made invisible, so the launch stage is a plain blush field with no
     artwork at all.

     Why the icon must be set EXPLICITLY:
       * omitted  -> the platform falls back to the launcher icon, which
                     rendered as a big flat pink heart with no text (the screen
                     the user asked to delete);
       * the old `ic_tapcare_logo` gradient circle -> also a heart with no
                     text, just prettier;
       * a transparent drawable -> invisible, so nothing shows.
     Hence `ic_tapcare_splash_blank`, plus a blush icon background so the
     system's icon backdrop circle is invisible too. `launch_background` is
     blush-only for the same reason (see res/drawable/launch_background.xml).

     NOTE: there is no `android:windowSplashScreenIconBackgroundSize`
     platform attribute — only `...IconBackgroundColor`. An earlier revision
     of this file declared the size variant and resource linking failed with
     "style attribute not found". -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/tapcare_blush</item>
        <!-- Invisible: never point this at a heart/logo, it becomes a second
             text-less splash screen. -->
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_tapcare_splash_blank</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/tapcare_blush</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
    </style>

    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/tapcare_blush</item>
    </style>
</resources>