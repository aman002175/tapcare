<?xml version="1.0" encoding="utf-8"?>
<!-- The TapCare logo — gradient circle + white heart.

     This is deliberately the *same* mark the Flutter splash draws
     (Rom.loveGradient circle with a white heart), so the Android 12 splash and
     the in-app splash read as ONE continuous opening scene instead of a plain
     heart followed by a different screen. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="48"
    android:viewportHeight="48">

    <!-- gradient circle -->
    <path android:pathData="M24,3 a21,21 0 1,0 0.1,0 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="3"
                android:startY="3"
                android:endX="45"
                android:endY="45"
                android:type="linear">
                <item android:offset="0" android:color="#FFFF9EBB" />
                <item android:offset="1" android:color="#FFFF6E91" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- white heart, centred on the circle -->
    <group
        android:pivotX="12"
        android:pivotY="12"
        android:translateX="12"
        android:translateY="12"
        android:scaleX="0.62"
        android:scaleY="0.62">
        <path
            android:pathData="M12,21.35l-1.45,-1.32C5.4,15.36 2,12.28 2,8.5 2,5.42 4.42,3 7.5,3c1.74,0 3.41,0.81 4.5,2.09C13.09,3.81 14.76,3 16.5,3 19.58,3 22,5.42 22,8.5c0,3.78 -3.4,6.86 -8.55,11.54L12,21.35z"
            android:fillColor="#FFFFFFFF" />
    </group>
</vector>