<?xml version="1.0" encoding="utf-8"?>
<!-- Launch window (drawn until Flutter paints its first frame): blush only.

     This used to stack the TapCare heart logo on top of the background, which
     showed up as a second, text-less heart screen between the system splash
     and the Flutter splash. With no artwork here, every native launch stage
     is a plain blush field and the app opens straight into the Flutter splash
     that carries the logo and the text. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/tapcare_blush" />
</layer-list>