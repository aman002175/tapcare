<?xml version="1.0" encoding="utf-8"?>
<!-- Launch window for API 24-30: blush background + the TapCare logo.

     The logo is the same gradient circle the Flutter splash draws, so the
     hand-off from the native window to the in-app splash is invisible. (The old
     flat pink heart here read as a second, plainer opening screen; the plain
     blank window read as a white flash.) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/tapcare_blush" />
    <item
        android:width="96dp"
        android:height="96dp"
        android:gravity="center"
        android:drawable="@drawable/ic_tapcare_logo" />
</layer-list>