<?xml version="1.0" encoding="utf-8"?>
<!-- Branded launch screen: blush background + centred heart logo, so the
     cold start no longer flashes a blank white window before Flutter runs. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/tapcare_blush" />
    <item
        android:width="120dp"
        android:height="120dp"
        android:gravity="center"
        android:drawable="@drawable/ic_tapcare_heart" />
</layer-list>
