<?xml version="1.0" encoding="utf-8"?>
<!-- Fully transparent splash icon.

     Android 12+ renders a splash icon no matter what, so the icon slot is
     filled with this no-op drawable instead of the app launcher icon or the
     old pink heart. Layer-list + solid transparent colour is used (rather than
     an empty <vector>) because a vector without paths is not accepted by
     every aapt version. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@android:color/transparent" />
</layer-list>